<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarTranscript"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="日英対訳スクリプト履歴"
            app:titleTextColor="@color/on_surface" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- エクスポート・操作アクションエリア -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyMarkdown"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Markdownコピー"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:strokeColor="@color/primary" />

            <Button
                android:id="@+id/btnShareTranscript"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="共有"
                android:textColor="@color/on_surface"
                android:textSize="12sp"
                app:strokeColor="@color/divider_color" />

            <Button
                android:id="@+id/btnClearHistory"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="クリア"
                android:textColor="@color/error_red"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 件数カウント -->
        <TextView
            android:id="@+id/tvCountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="保存済み字幕: 0件"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <!-- 空状態の表示 -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="YouTube動画を再生すると、日英対訳スクリプトがここに自動記録されます。"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- スクリプト一覧リスト -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTranscripts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_transcript_row" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
