<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/background">

    <!-- トップナビゲーションバー (横スライド・スクロール対応) -->
    <HorizontalScrollView
        android:id="@+id/layoutNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="4dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/layoutNavContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnNavBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_back"
                android:src="@drawable/ic_arrow_back" />

            <ImageButton
                android:id="@+id/btnNavForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_forward"
                android:src="@drawable/ic_arrow_forward" />

            <ImageButton
                android:id="@+id/btnNavReload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_reload"
                android:src="@drawable/ic_refresh" />

            <!-- URL入力バー -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_url_bar">

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/url_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant"
                    android:textSize="13sp" />
            </FrameLayout>

            <!-- 現在の動作モードバッジ -->
            <TextView
                android:id="@+id/tvModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_status_badge"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="最適構成"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 再生 / 一時停止ボタン -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="再生/一時停止"
                android:src="@drawable/ic_play_arrow" />

            <!-- 字幕 (CC) 切替ボタン -->
            <ImageButton
                android:id="@+id/btnToggleCc"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="字幕(CC)切替"
                android:src="@drawable/ic_subtitles" />

            <!-- 日英対訳スクリプト履歴ボタン -->
            <ImageButton
                android:id="@+id/btnTranscript"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="スクリプト履歴"
                android:src="@drawable/ic_transcript" />

            <!-- 原音ミュート切替ボタン -->
            <ImageButton
                android:id="@+id/btnMuteToggle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="原音ミュート切替"
                android:src="@drawable/ic_volume_off" />

            <!-- ピクチャー・イン・ピクチャー (PiP) ボタン -->
            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="小窓再生 (PiP)"
                android:src="@drawable/ic_pip" />

            <!-- 画面消灯・バックグラウンド再生切替ボタン -->
            <ImageButton
                android:id="@+id/btnBackgroundAudio"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="画面消灯・バックグラウンド再生切替"
                android:src="@drawable/ic_music_note" />

            <!-- 全画面 / 最大化ボタン -->
            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="全画面表示 (最大化)"
                android:src="@drawable/ic_fullscreen" />

            <!-- 設定ボタン -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ページ読み込みプログレスバー -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="@color/primary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutNavBar" />

    <!-- フルスクリーン WebView (ハードウェアアクセラレーション最適化) -->
    <WebView
        android:id="@+id/wvBrowser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <!-- フルスクリーン動画表示用コンテナ (HTML5 動画全画面・最大化時) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- フローティング 字幕＆ステータス オーバーレイ (ドラッグ移動・最小化・位置切替対応) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSubtitleOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/overlay_background"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <!-- ドラッグ移動ハンドルバー (タッチ領域 24dp 確保) -->
            <FrameLayout
                android:id="@+id/layoutDragTouchArea"
                android:layout_width="match_parent"
                android:layout_height="24dp">

                <View
                    android:id="@+id/viewDragHandle"
                    android:layout_width="48dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_drag_handle" />
            </FrameLayout>

            <!-- パイプライン状態ヘッダー ＆ 操作ボタン群 -->
            <LinearLayout
                android:id="@+id/layoutCardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/bg_status_badge"
                    app:tint="@color/accent_green" />

                <TextView
                    android:id="@+id/tvPipelineStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/status_ready"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPrefetchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="先読み: 0件"
                    android:textColor="@color/primary"
                    android:textSize="10sp" />

                <!-- 字幕 (CC) 切替ボタン（全画面時にも直接操作可能） -->
                <ImageButton
                    android:id="@+id/btnCardToggleCc"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="字幕(CC)切替"
                    android:padding="5dp"
                    android:src="@drawable/ic_subtitles"
                    app:tint="@color/on_surface_variant" />

                <!-- 上下位置切り替えボタン -->
                <ImageButton
                    android:id="@+id/btnDockPosition"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="上/下に移動"
                    android:padding="5dp"
                    android:src="@drawable/ic_swap_vert"
                    app:tint="@color/on_surface_variant" />

                <!-- 最小化 / 展開ボタン -->
                <ImageButton
                    android:id="@+id/btnMinimizeCard"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="最小化/展開"
                    android:padding="5dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/on_surface_variant" />

                <!-- 閉じる（非表示）ボタン -->
                <ImageButton
                    android:id="@+id/btnCloseCard"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="字幕カードを閉じる"
                    android:padding="5dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- 字幕本文および通知コンテナ (最小化時に非表示化) -->
            <LinearLayout
                android:id="@+id/layoutSubtitleContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- 翻訳後の日本語テキスト (メイン表示) -->
                <TextView
                    android:id="@+id/tvTranslatedSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="UniVoice 音声翻訳待機中..."
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 原文字幕 (小文字で表示) -->
                <TextView
                    android:id="@+id/tvOriginalSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Waiting for YouTube video subtitles..."
                    tools:visibility="visible" />

                <!-- ダウンロード徹底バッチ翻訳 開始・進捗UI (バッチモード時かつ動画ページで表示) -->
                <LinearLayout
                    android:id="@+id/layoutBatchControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_card"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBatchTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎬 AI音声吹き替え（徹底バッチ翻訳）"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartBatchDubbing"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="@color/primary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="吹き替えを開始"
                            android:textColor="@color/on_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBatchDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="YouTubeの字幕有無に関係なく、AIが動画音声から文字起こし＆尺合わせ日本語吹き替えを生成します"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />

                    <!-- バッチ処理プログレスバー＆ステータス -->
                    <LinearLayout
                        android:id="@+id/layoutBatchProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ProgressBar
                            android:id="@+id/pbBatchProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:progressTint="@color/primary" />

                        <TextView
                            android:id="@+id/tvBatchProgressText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="AIによる音声解析準備中..."
                            android:textColor="@color/accent_amber"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- エラー・フォールバック通知バー (非侵入的オーバーレイ) -->
                <LinearLayout
                    android:id="@+id/layoutErrorOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_rounded_card"
                    android:orientation="horizontal"
                    android:padding="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvErrorMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/error_translation_failed"
                        android:textColor="@color/accent_amber"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnDismissError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="閉じる"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 字幕再表示用 フローティングピルボタン (字幕非表示時のみ画面端に小さく出現) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRestoreSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_subtitles"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="字幕を表示"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
